  "description": "PostgreSQL read-replica routing: how much load left the primary, whether the replicas can be trusted, and what the consistency guarantee costs.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Is it paying off?",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Reads served by a replica",
      "description": "The number the whole feature exists for. Its ceiling is arithmetic: a request that writes taints itself, so its own reads come back to the primary. At a read share r the most that can ever leave is r/(2-r) — 33% at a 50/50 mix, not 50%.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "green",
                "value": 0.3
              }
            ]
          },
          "unit": "percentunit",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "editorMode": "code",
          "expr": "sum(rate(postgres_route_decisions_total{job=~\"$job\", target=\"replica\"}[$__rate_interval])) / clamp_min(sum(rate(postgres_route_decisions_total{job=~\"$job\", class=\"read\"}[$__rate_interval])), 0.001)",
          "legendFormat": "offload",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Statements on the primary",
      "description": "What the primary still has to serve. This is the line that should fall when routing is switched on.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "x": 6,
